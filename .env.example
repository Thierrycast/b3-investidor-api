# Copie para .env (que o git ignora) e preencha só o que for usar.

# Onde a sessão (refresh_token) fica guardada. Arquivo criado com modo 600.
# Padrão: ~/.config/b3-investidor/session.json
B3_SESSION_FILE=

# --- Login facilitado (b3 login) ---
# Opcionais. Sem eles, o login abre a janela e você digita tudo.
# A senha só fica na memória do processo; apague daqui depois do primeiro login se preferir.
B3_CPF=
B3_SENHA=

# --- Servidor HTTP (b3 serve) ---
# Chave exigida no header "x-api-key". Gere com: openssl rand -hex 32
B3_API_KEY=
B3_HOST=127.0.0.1
B3_PORT=8790
# Webhook opcional (POST JSON) avisado quando a renovação falhar e for preciso logar de novo.
B3_ALERT_WEBHOOK=
