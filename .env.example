# Copie para .env (que o git ignora) e preencha só o que for usar.

# Onde a sessão (refresh_token) fica guardada. Arquivo criado com modo 600.
# Padrão: ~/.config/b3-investidor/session.json
B3_SESSION_FILE=

# --- Credenciais (b3 login e login automático do servidor) ---
# Alternativa mais segura: `b3 credenciais salvar` (cofre do sistema) e deixar estes vazios.
# Ordem de leitura: estas variáveis, depois o cofre.
B3_CPF=
B3_SENHA=
# Navegador do login sem janela. Vazio = Chrome/Edge instalado, ou o Chromium do sistema
# em Linux (/usr/bin/chromium-headless-shell, chromium-browser, chromium).
B3_CHROMIUM_PATH=

# --- Servidor HTTP (b3 serve) ---
# Chave exigida no header "x-api-key". Gere com: openssl rand -hex 32
B3_API_KEY=
B3_HOST=127.0.0.1
B3_PORT=8790
# Login automático quando a sessão vence (precisa das credenciais acima). 0 desliga.
B3_AUTO_LOGIN=1
# Quanto uma requisição espera o login automático antes de responder 503 (ms).
B3_LOGIN_ESPERA_MS=90000
# Webhook opcional (POST JSON): avisa quando a B3 pede o código do e-mail, quando o login
# automático falha e quando a sessão está perto de vencer.
B3_ALERT_WEBHOOK=